{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/test.html",
      "dest": "/test.html"
    },
    {
      "src": "/(.*)",
      "dest": "/test.html"
    }
  ]
} 