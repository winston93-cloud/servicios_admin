# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# URL pública de la app (logos en correos masivos). En Vercel suele ser https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Correo masivo (Gmail / avisos no-reply, igual que agendaw)
MAIL_USER=avisos_no-replay@winston93.edu.mx
MAIL_PASS=tu_password_de_aplicacion_gmail
# Opcional: inserciones masivas en migración
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# MySQL legacy (phpMyAdmin / winston_general) — solo servidor, migración local
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=winston_general
# Solo si en MySQL los nombres difieren (en local a veces no hay estas tablas)
# MYSQL_TABLE_ALUMNO=alumno
# MYSQL_TABLE_ALUMNO_DETALLES=alumno_detalles
# MYSQL_TABLE_ALUMNO_FAMILIAR=alumno_familiar

# Opcional: proteger POST /api/migracion-alumno
MIGRACION_SECRET=elige_un_secreto_largo