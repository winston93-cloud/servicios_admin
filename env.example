# InsForge — Winston Servicios (base de datos del portal)
# URL: campo oss_host en .insforge/project.json
# Anon: npx @insforge/cli secrets get ANON_KEY
# API (solo servidor): npx @insforge/cli secrets get API_KEY
NEXT_PUBLIC_INSFORGE_URL=https://g4ta4bfg.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here
INSFORGE_API_KEY=your_insforge_api_key_here

# URL pública de la app (logos en correos masivos). En Vercel suele ser https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# App Prórrogas y Ajustes (hub con tarjetas Prórrogas / Ajustes)
NEXT_PUBLIC_PRORROGAS_AJUSTES_URL=http://localhost:3001

# Caja chica — Monitoreo y Control (dashboard administrativo)
NEXT_PUBLIC_CCHIC_URL=https://cchic.vercel.app

# Dashboard — módulos legacy (tarjetas Cheques, Boletas, Becas alumno, Reportes de conducta)
NEXT_PUBLIC_CHEQUES_URL=https://www.winston93.edu.mx/cheques
NEXT_PUBLIC_BOLETAS_URL=https://www.winston93.edu.mx/boletas
NEXT_PUBLIC_BOLETAS_ALUMNO_URL=https://www.winston93.edu.mx/boletas
NEXT_PUBLIC_BECAS_ALUMNO_URL=https://winston93.edu.mx/becas
NEXT_PUBLIC_REPORTES_CONDUCTA_URL=https://www.winston93.edu.mx/secundaria_2.0

# Facturas CFDI legacy (visor PDF/XML en portal de pagos alumno)
NEXT_PUBLIC_FACTURAS_BASE_URL=https://www.winston93.edu.mx/banorte/facturas

# Módulo Facturación CFDI (admin) — enlaces al PHP legacy durante la transición
NEXT_PUBLIC_CFDI_LEGACY_URL=https://www.winston93.edu.mx/cfdiwinston
NEXT_PUBLIC_CFDI_REPORTE_XML_URL=https://www.winston93.edu.mx/xml

# FacturoPorTi PAC (solo servidor — Fase 3 timbrado)
FACTUROPORTI_API_URL=https://api.facturoporti.com.mx
FACTUROPORTI_BEARER_CHURCHILL=
FACTUROPORTI_BEARER_EDUCATIVO=
# CSD por emisor (base64, secrets en Vercel — no commitear)
# FACTUROPORTI_CHURCHILL_CSD=
# FACTUROPORTI_CHURCHILL_KEY=
# FACTUROPORTI_CHURCHILL_CSD_PASSWORD=
# FACTUROPORTI_CHURCHILL_LOGO_BASE64=
# FACTUROPORTI_EDUCATIVO_CSD=
# FACTUROPORTI_EDUCATIVO_KEY=
# FACTUROPORTI_EDUCATIVO_CSD_PASSWORD=
# FACTUROPORTI_EDUCATIVO_LOGO_BASE64=

# OpenPay SPEI (portal de pagos — integrado en Next, sin carpeta spei legacy)
# Winston Churchill: nivel alumno >= 3
OPENPAY_WINSTON_MERCHANT_ID=
OPENPAY_WINSTON_SECRET_KEY=
OPENPAY_WINSTON_PUBLIC_KEY=
# Alias válidos en Vercel: OPENPAY_WINSTON_SECRET y OPENPAY_WINSTON_PUBLIC
# Educativo / Maternal-Kinder: nivel < 3
OPENPAY_EDUCATIVO_MERCHANT_ID=
OPENPAY_EDUCATIVO_SECRET_KEY=
OPENPAY_EDUCATIVO_PUBLIC_KEY=
# Alias: OPENPAY_EDUCATIVO_SECRET y OPENPAY_EDUCATIVO_PUBLIC
OPENPAY_SANDBOX=false

# Webhooks OpenPay (registrar en dashboard OpenPay, una URL por merchant):
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/openpay/winston
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/openpay/educativo
# OPENPAY_WEBHOOK_RELAX_SIGNATURE=false

# Banorte — comercio electrónico (3D Secure + Payworks)
BANORTE_WINSTON_MERCHANT_ID=9352049
BANORTE_WINSTON_TERMINAL_ID=93520491
BANORTE_WINSTON_USER=
BANORTE_WINSTON_PASSWORD=
BANORTE_WINSTON_NOMBRE_COMERCIO=INST WINSTON CHURCHILL
BANORTE_WINSTON_CIUDAD_COMERCIO=CIUDAD MADERO
BANORTE_WINSTON_CERTIFICACION_3D=03
BANORTE_EDUCATIVO_MERCHANT_ID=9439810
BANORTE_EDUCATIVO_TERMINAL_ID=94398101
BANORTE_EDUCATIVO_USER=
BANORTE_EDUCATIVO_PASSWORD=
BANORTE_EDUCATIVO_NOMBRE_COMERCIO=INST WINSTON
BANORTE_EDUCATIVO_CIUDAD_COMERCIO=CIUDAD MADERO
BANORTE_EDUCATIVO_CERTIFICACION_3D=03

# Correo masivo (Gmail / avisos no-reply)
MAIL_USER=avisos_no-replay@winston93.edu.mx
MAIL_PASS=tu_password_de_aplicacion_gmail

# MySQL legacy (panel migración MySQL → InsForge; opcional)
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=winston_general

# Proteger POST /api/migracion-tablas
MIGRACION_SECRET=elige_un_secreto_largo

# --- Deprecado: ya no usar Supabase para este proyecto ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Portal de inscripciones — enlaces legacy y documentos JWT
NEXT_PUBLIC_ADMISIONES_LEGACY_URL=https://winston93.edu.mx/admisiones
NEXT_PUBLIC_PORTAL_DOCUMENTOS_URL=https://documentos.winston93.edu.mx/documentos
# Debe coincidir con admisiones/module/jwt.php (mín. 16 caracteres)
JWT_DOCUMENTOS_SECRET=
JWT_DOCUMENTOS_ISSUER=winston-escolar
JWT_DOCUMENTOS_TTL_SEC=3600
# Fecha MM-DD en que el ciclo escolar “da el salto” (legacy admisiones: 07-10)
ADMISIONES_CAMBIO_CICLO=07-10

# Dashboard InsForge → proyecto AgendaW → API keys
NEXT_PUBLIC_ADMISSION_INSFORGE_URL=https://sr6a9iza.us-east.insforge.app
NEXT_PUBLIC_ADMISSION_INSFORGE_ANON_KEY=
ADMISSION_INSFORGE_API_KEY=

# Google Calendar (citas de admisión)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
